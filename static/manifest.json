{
  "manifest_version": 3,
  "name": "Copy Image as PNG",
  "version": "1.0.0",
  "description": "Right-click any image (SVG, WebP, AVIF, inline SVG, CSS backgrounds) to copy it as a PNG, or save it as PNG/JPG. Great for pasting logos into Google Slides.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["contextMenus", "offscreen", "clipboardWrite", "downloads", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
